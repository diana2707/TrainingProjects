{
	"ConnectionStrings": {
		"HotelListingDbConnectionString": "Server=(localdb)\\mssqllocaldb;Database=HotelListingAPIDb;Trusted_Connection=True;MultipleActiveResultSets=True"
	},
	"Serilog": {
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsift": "Warning",
				"Microsoft.Hostong.Lifetime": "Information"
			}
		},
		"WriteTo": [
			{
				"Name": "File",
				"Args": {
					"path": "./logs/log-.txt",
					"rollingInterval": "Day"
				}
			},
			{
				"Name": "Seq",
				"Args": { "serverUrl": "http://localhost:5341" }
			}
		]
	},
	"AllowedHosts": "*"
}